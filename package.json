{
  "name": "@opsrev/acculynx-cli",
  "version": "1.12.0",
  "description": "AccuLynx MCP server & CLI — use the AccuLynx roofing CRM in Claude Desktop, Cursor, and any MCP client. Also a JSON CLI for scripts and AI agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsrev/acculynx-cli.git"
  },
  "homepage": "https://github.com/opsrev/acculynx-cli#readme",
  "bugs": {
    "url": "https://github.com/opsrev/acculynx-cli/issues"
  },
  "mcpName": "io.github.opsrev/acculynx",
  "type": "module",
  "bin": {
    "acculynx": "./dist/index.js",
    "acculynx-mcp": "./dist/mcp.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/mcp.ts --format esm --dts --clean",
    "dev": "tsx --env-file=.env src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "acculynx",
    "acculynx-mcp",
    "mcp",
    "model-context-protocol",
    "modelcontextprotocol",
    "claude",
    "claude-desktop",
    "cursor",
    "ai-agents",
    "roofing",
    "roofing-crm",
    "crm",
    "cli",
    "api"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
